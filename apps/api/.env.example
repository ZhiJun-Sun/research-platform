# ==========================================================================
# HydroLab API 配置样例。复制为 .env 使用；禁止提交真实 Secret。
# 未启用真实后端时，对应配置可留空，系统以 Fake 适配器运行。
# ==========================================================================

HYDROLAB_ENVIRONMENT=local
HYDROLAB_PUBLIC_BASE_URL=http://127.0.0.1:8000
HYDROLAB_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# --- 安全（生产必须替换，启动时强校验） ---
HYDROLAB_AUTH_SECRET=dev-only-insecure-secret
HYDROLAB_RUNNER_SIGNING_KEY=dev-only-runner-key

# --- 首个管理员（仅系统无用户时生效一次） ---
# local/test 不配置时使用开发默认 admin@hydrolab.cn / admin123456；
# production 必须显式配置。
# HYDROLAB_BOOTSTRAP_ADMIN_EMAIL=
# HYDROLAB_BOOTSTRAP_ADMIN_PASSWORD=
# HYDROLAB_BOOTSTRAP_ADMIN_NAME=平台管理员

# --- 数据库接入（真实 MySQL，需显式启用） ---
# 存储后端：memory（进程内，默认，无库开发/测试）| mysql（真实持久化）。
# 默认 memory：应用启动绝不连接外部数据库。要接真实库时改为 mysql 并配置 URL。
# 连接串使用 asyncmy 异步驱动；密码中的 @ 需编码为 %40。
HYDROLAB_DATABASE_BACKEND=memory
# HYDROLAB_DATABASE_URL=mysql+asyncmy://USER:PASS@127.0.0.1:3306/hydrolab?charset=utf8mb4

# --- 基础设施（真实服务接入后填写） ---
# Celery 队列（TASK_QUEUE_BACKEND=celery 时生效）
# HYDROLAB_REDIS_URL=redis://127.0.0.1:6379/0
# MLflow 跟踪（EXPERIMENT_TRACKER_BACKEND=mlflow 时生效）
# HYDROLAB_MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# --- S3-compatible object storage（OBJECT_STORAGE_BACKEND=s3 时生效） ---
# HYDROLAB_S3_ENDPOINT=http://127.0.0.1:9000
# HYDROLAB_S3_REGION=us-east-1
# HYDROLAB_S3_BUCKET=hydrolab
# HYDROLAB_S3_ACCESS_KEY=
# HYDROLAB_S3_SECRET_KEY=
# HYDROLAB_S3_ADDRESSING_STYLE=path

# --- 后端实现选择：fake 为默认；真实实现需通过 plans/05 对应 Spike ---
HYDROLAB_OBJECT_STORAGE_BACKEND=fake    # fake | local | s3
HYDROLAB_TASK_QUEUE_BACKEND=fake        # fake | celery
HYDROLAB_EXPERIMENT_TRACKER_BACKEND=fake # fake | noop | mlflow
HYDROLAB_RUN_EXECUTOR_BACKEND=fake      # fake | subprocess | docker

# --- local 对象存储根目录（OBJECT_STORAGE_BACKEND=local 时生效） ---
HYDROLAB_LOCAL_STORAGE_ROOT=.hydrolab-data/objects

# ==========================================================================
# 真实执行链路（本机 / 单机服务器）
# 目标：把一个真实工程目录导入为不可变代码版本，并真实执行训练、采集产物。
# 参考：scripts/verify_da0_e2e.py 为该链路的端到端验收脚本。
# ==========================================================================

# --- 本地目录代码导入白名单（必填才能使用目录导入） ---
# 只有位于这些根目录之内的路径可被导入，防止任意主机路径被打包外泄。
# HYDROLAB_CODE_IMPORT_ROOTS=["/Users/you/Desktop","/srv/projects"]

# --- subprocess Runner（HYDROLAB_RUN_EXECUTOR_BACKEND=subprocess 时生效） ---
# 注意：subprocess 缺少容器隔离，生产环境启动时会被拒绝，请改用 docker。
# 每个 Run 获得独立工作目录 <root>/<run_id>/{code,output}
# HYDROLAB_RUNNER_WORKSPACE_ROOT=.hydrolab-data/runs
# 训练进程使用的解释器；需含训练依赖（torch 等），通常与 API 的 venv 不同。
# HYDROLAB_RUNNER_PYTHON_EXECUTABLE=/usr/bin/python3
# 只读数据根：会以 code/datasets 软链接暴露，使代码内相对路径 "datasets/x" 生效。
# HYDROLAB_RUNNER_DATA_ROOT=/srv/hydrolab/datasets
# HYDROLAB_RUNNER_DEFAULT_TIMEOUT_SECONDS=21600

# --- Docker GPU Runner（HYDROLAB_RUN_EXECUTOR_BACKEND=docker 时生效） ---
# Runner Controller 会校验镜像 digest 白名单后再启动容器；生产禁止通配符。
# HYDROLAB_RUNNER_IMAGE_WHITELIST=["example.com/train@sha256:abc..."]
# 每个 Run 获得独立容器；默认禁网、只读代码/数据挂载、非 root。
# HYDROLAB_RUNNER_ALLOW_NETWORK=false
# 容器内运行的受控解释器（docker exec 时用）
# HYDROLAB_RUNNER_CONTAINER_PYTHON=/usr/local/bin/python

# --- 配额 ---
HYDROLAB_STORAGE_QUOTA_BYTES=536870912000
HYDROLAB_STORAGE_LOW_WATERMARK_BYTES=53687091200
