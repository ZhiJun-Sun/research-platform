# ==========================================================================
# HydroLab 生产环境变量模板。复制为 .env.production 后填写；不要提交真实密钥。
# 生产显式选择真实后端（数据库/对象存储/队列/追踪/执行），不默认静默落到 fake；
# fake 仅在本地开发 profile 或明确回退时使用。缺少强制变量时服务启动失败并给出提示。
# ==========================================================================

# --- 安全（强制，缺一不可；替换为 64 位随机串） ---
HYDROLAB_AUTH_SECRET=replace-with-a-64-char-random-secret
HYDROLAB_RUNNER_SIGNING_KEY=replace-with-a-separate-64-char-random-secret
HYDROLAB_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
HYDROLAB_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
HYDROLAB_BOOTSTRAP_ADMIN_NAME=平台管理员

# --- 基础设施凭据（Compose 使用，缺一启动失败） ---
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_PASSWORD=replace-with-a-strong-password
MINIO_ROOT_USER=hydrolab-minio
MINIO_ROOT_PASSWORD=replace-with-a-strong-password

# --- 对外暴露（部署到服务器供他人访问时把 BIND 改为 0.0.0.0；端口改为任一空闲端口） ---
# 绑定 127.0.0.1：仅服务器本机 / SSH 隧道可达（最保守，适合先内测）；
# 绑定 0.0.0.0：局域网/外网经 http://<服务器IP>:<端口> 直达（HTTP 明文，公网正式使用建议外层加 TLS 反代）。
HYDROLAB_WEB_BIND=127.0.0.1
HYDROLAB_WEB_PORT=8080
HYDROLAB_MINIO_CONSOLE_BIND=127.0.0.1
HYDROLAB_MINIO_CONSOLE_PORT=9001
# 平台对外访问地址（影响分享链接生成；用 IP 直连就填 http://<服务器IP>:<HYDROLAB_WEB_PORT>）
HYDROLAB_PUBLIC_BASE_URL=http://127.0.0.1:8080
# 跨域来源白名单（前端与 API 同源部署时留空即可；JSON 数组格式）
HYDROLAB_CORS_ORIGINS=[]

# --- 真实后端开关（生产显式选真实实现） ---
# 数据库
HYDROLAB_DATABASE_BACKEND=mysql
# 对象存储（MinIO/S3）；compose 内 endpoint 指向 minio 服务
HYDROLAB_OBJECT_STORAGE_BACKEND=s3
HYDROLAB_S3_BUCKET=hydrolab
HYDROLAB_S3_ADDRESSING_STYLE=path
# 任务队列（Celery + Redis）；compose 内 Redis 地址
HYDROLAB_TASK_QUEUE_BACKEND=celery
# 实验追踪（MLflow）；compose 内 MLflow 地址
HYDROLAB_EXPERIMENT_TRACKER_BACKEND=mlflow
# Run 执行：docker 需要宿主机 NVIDIA 驱动 + docker gpu runtime + 镜像白名单；
# 若宿主机无 GPU，须显式改回 subprocess（仅本机）或 fake（明确回退），不得静默。
HYDROLAB_RUN_EXECUTOR_BACKEND=docker
# Linux Docker host and Worker must share this same absolute path.
HYDROLAB_RUNNER_WORKSPACE_ROOT=/srv/hydrolab/runs
# Docker Runner 镜像白名单（必填，禁通配符）；示例镜像 digest 需替换为实际训练镜像
HYDROLAB_RUNNER_IMAGE_WHITELIST=["example.com/train@sha256:REPLACE_WITH_REAL_DIGEST"]
